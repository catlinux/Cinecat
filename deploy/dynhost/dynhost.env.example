# Configuración del cliente DynHost de OVH (deploy/dynhost/ovh-dynhost.sh).
# Cópiala a ~/.config/cinecat/dynhost.env con permisos 0600:
#   install -m 600 deploy/dynhost/dynhost.env.example ~/.config/cinecat/dynhost.env

# Nombre completo del registro DynHost creado en el panel de OVH.
DYNHOST_HOSTNAME=media.techmarc.es

# Identificador y contraseña DynHost (Web Cloud > DNS zones > tu dominio >
# DynHost > Manage access). No son los de tu cuenta de OVH.
DYNHOST_USER=
DYNHOST_PASSWORD=

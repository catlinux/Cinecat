# Copia este archivo a .env en el mismo directorio que docker-compose.yml
# (en el Debian, no en el repositorio) y ajusta los valores. .env no se versiona.

# Carpeta real de tu biblioteca de vídeos en el Debian (se monta solo lectura).
CINECAT_MEDIA_PATH=/home/tuusuario/Videos

# Dominio o IP:puerto por el que accederás (ej. cinecat.tudominio.com o
# 192.168.1.10). Deja ":80" (valor por defecto) para HTTP sin dominio propio;
# si pones un dominio real, Caddy pedirá un certificado HTTPS automático.
CINECAT_DOMAIN=:80

# Clave de la API de TMDB (opcional por ahora, metadatos aún no conectados).
CINECAT_TMDB_API_KEY=

# Contraseña del usuario admin en el primer arranque (solo importa la primera
# vez; se ignora si ya existe algún usuario). Si la dejas vacía, el servidor
# genera una contraseña aleatoria y la imprime una sola vez en
# "docker compose logs servidor" tras el primer arranque.
CINECAT_ADMIN_PASSWORD=

# Copia este archivo a .env en el mismo directorio que docker-compose.yml
# (en el Debian, no en el repositorio) y ajusta los valores. .env no se versiona.

# Punto de montaje real en el Debian que contiene tus bibliotecas (se monta
# entero, solo lectura, como /media dentro del contenedor). Por ejemplo, si
# tus carpetas son /media/Multimedia/Pelis y /media/Multimedia/Series, deja
# CINECAT_MEDIA_PATH=/media y luego crea en Cinecat una biblioteca por cada
# subcarpeta (/media/Multimedia/Pelis, /media/Multimedia/Series).
CINECAT_MEDIA_PATH=/media

# Puertos locales (solo 127.0.0.1, nunca expuestos a la red) donde escuchan
# el servidor y el cliente web; Apache hace de proxy hacia ellos (ver
# deploy/video.warcrafted.com.conf). Cambia estos valores solo si ya usas
# esos puertos para otra cosa en el mismo Debian.
CINECAT_API_PORT=8080
CINECAT_WEB_PORT=8081

# Clave de la API de TMDB (opcional, metadatos aún no conectados para TMDB).
CINECAT_TMDB_API_KEY=

# Clave de la API de OMDb (omdbapi.com, solo pide un email para la gratuita):
# metadatos de películas (sinopsis, cartel), 1000 peticiones/día. Sin ella el
# escaneo sigue funcionando igual, solo sin sinopsis ni cartel.
CINECAT_OMDB_API_KEY=

# Cada cuánto se escanea sola la biblioteca (duración Go: 6h, 30m, 1h30m).
# 0 desactiva el escaneo automático; el botón «Escanear» de la web sigue
# funcionando. El primer escaneo tras arrancar se lanza al minuto.
CINECAT_SCAN_INTERVAL=6h

# Contraseña del usuario admin en el primer arranque (solo importa la primera
# vez; se ignora si ya existe algún usuario). Si la dejas vacía, el servidor
# genera una contraseña aleatoria y la imprime una sola vez en
# "docker compose logs servidor" tras el primer arranque.
CINECAT_ADMIN_PASSWORD=
